# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Every variable is optional: with no .env the app runs offline with the fake LLM.

# ── Model provider ───────────────────────────────────────────────────────
# databricks : Databricks AI Gateway (OpenAI-compatible), auth via the Databricks SDK
# openai     : any OpenAI-compatible endpoint (OpenAI, Azure-compatible proxies, vLLM, Ollama)
# fake       : offline, returns empty-but-valid JSON (tests / UI work without a model)
DOCINTEL_LLM_PROVIDER=fake
DOCINTEL_LLM_DISPLAY_NAME=LLM

# Model (or gateway route) per tier. Tiers may share one model with different reasoning effort.
DOCINTEL_LLM_MODEL_FAST=
DOCINTEL_LLM_MODEL_STRONG=
DOCINTEL_LLM_MODEL_VISION=
DOCINTEL_LLM_EFFORT_FAST=low
DOCINTEL_LLM_EFFORT_STRONG=high
DOCINTEL_LLM_EFFORT_VISION=low

# provider=databricks — choose ONE identity:
#   a CLI profile (personal login: `databricks auth login --profile <name>`), or
#   a service principal (containers), or a personal access token.
DOCINTEL_DATABRICKS_PROFILE=
DOCINTEL_DATABRICKS_HOST=
DOCINTEL_DATABRICKS_CLIENT_ID=
DOCINTEL_DATABRICKS_CLIENT_SECRET=
DOCINTEL_DATABRICKS_TOKEN=
DOCINTEL_DATABRICKS_GATEWAY_PATH=/ai-gateway/openai/v1

# provider=openai
DOCINTEL_LLM_BASE_URL=
DOCINTEL_LLM_API_KEY=

# Client-side limits (stay under the provider's quotas instead of collecting 429s)
DOCINTEL_LLM_RPM=120
DOCINTEL_LLM_TPM=600000
DOCINTEL_LLM_MAX_CONCURRENCY=8

# ── Embeddings for hybrid retrieval / search ─────────────────────────────
# fastembed: local multilingual ONNX model (downloaded once into data/models)
# openai   : OpenAI-compatible /embeddings (e.g. Ollama nomic-embed-text)
DOCINTEL_EMBEDDINGS_PROVIDER=fastembed
DOCINTEL_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCINTEL_EMBEDDINGS_BASE_URL=
DOCINTEL_EMBEDDINGS_API_KEY=

# ── Parsing ──────────────────────────────────────────────────────────────
DOCINTEL_OCR_BACKEND=rapidocr
DOCINTEL_OCR_MIN_CONFIDENCE=0.85
DOCINTEL_VLM_ENABLED=true

# ── Storage / service ────────────────────────────────────────────────────
# DOCINTEL_DATA_DIR=./data
# DOCINTEL_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/docintel
DOCINTEL_API_PORT=8077
