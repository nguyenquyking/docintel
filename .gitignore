# ── Secrets: never commit ─────────────────────────────────────────────
# Real configuration lives in .env (local only). .env.example holds placeholders.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.databrickscfg
.secret-denylist
secrets/

# ── Runtime data: uploaded documents can be confidential ──────────────
data/
backend/data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.log
logs/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ── Node ──────────────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo

# ── Editors / OS ──────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
